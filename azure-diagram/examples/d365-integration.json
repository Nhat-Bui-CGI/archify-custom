  "edges": [
    { "from": "partner", "to": "apim", "step": 1, "label": "API call" },
    { "from": "apim", "to": "entra", "step": 2, "label": "Validate token" },
    { "from": "apim", "to": "logic", "step": 3 },
    { "from": "logic", "to": "bus", "step": 4, "label": "Queue message" },
    { "from": "bus", "to": "functions", "step": 5, "label": "Trigger" },
    { "from": "functions", "to": "vault", "step": 6, "label": "Read secrets" },
    { "from": "functions", "to": "d365", "step": 7, "bidirectional": true },
    { "from": "ax", "to": "boomi", "step": 8 },
    { "from": "boomi", "to": "bus", "step": 9, "label": "Publish over HTTPS", "style": "dashed" },
    { "from": "d365", "to": "fabric", "step": 10, "label": "Replicate", "style": "dashed" }
  ],
  "steps": [
    "A partner or client app calls the API on Azure API Management with an OAuth 2.0 access token.",
    "API Management validates the token against Microsoft Entra ID and applies its policies.",
    "API Management forwards the accepted request to a Logic Apps workflow.",
    "The workflow validates the payload and puts a message on a Service Bus topic, then returns an acknowledgement.",
    "The message triggers an Azure Function, which maps it to the Dynamics 365 data model.",
    "The function reads the secrets and certificates it needs from Key Vault with its managed identity.",
    "The function writes to Dynamics 365 and reads the result back.",
    "Boomi picks up changes from Dynamics AX 2012 on the local network.",
    "Boomi publishes these changes to Service Bus over outbound HTTPS, so they follow the same path from step 5.",
    "Dynamics 365 replicates business data to Microsoft Fabric for reporting."
  ]
}
